# ==============================================================================
# Configurazione Workshop: Reverse Logistics Fashion con Google ADK
# ==============================================================================

# Provider modello: "gemini" oppure "gemma"
MODEL_PROVIDER=gemini

# Se MODEL_PROVIDER=gemini:
# Inserisci qui la tua API Key gratuita da https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Se MODEL_PROVIDER=gemma (es. Ollama in locale su http://localhost:11434):
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma2:9b

# Parametri Harness
MAX_DECISION_STEPS=3
HITL_REFUND_THRESHOLD=500.0
WMS_API_ENDPOINT=mock://wms.fashionhub.internal/v1

